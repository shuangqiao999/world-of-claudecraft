.SnapFrame {
    tick 0 : integer
    time 1 : double
    tw   2 : integer
    self 3 : string
    ents 4 : *string
    keep 5 : *integer
}

.EventsFrame {
    list 0 : *Event
}
.Event {
    type 0 : string
    pid  1 : integer
    dmg  2 : double
    crit 3 : boolean
    x    4 : double
    z    5 : double
    y    6 : double
    targetId 7 : integer
    text  8 : string
    name  9 : string
    abilityId 10 : string
    amount 11 : double
    overkill 12 : boolean
    offhand 13 : boolean
    blocked 14 : boolean
    dodged 15 : boolean
    missed 16 : boolean
}

.HelloFrame {
    pid   0 : integer
    seed  1 : integer
    name  2 : string
    cls   3 : string
    realm 4 : string
    level 5 : integer
    skin  6 : integer
}

.SocialFrame {
    friends 0 : *FriendEntry
    blocks  1 : *integer
    ignores 2 : *integer
    guild   3 : GuildEntry
    pendingInvites 4 : *integer
}
.FriendEntry {
    id 0 : integer
    name 1 : string
    class 2 : string
    online 3 : boolean
}
.GuildEntry {
    id 0 : integer
    name 1 : string
    rank 2 : integer
    members 3 : *GuildMember
}
.GuildMember {
    id 0 : integer
    name 1 : string
    class 2 : string
    level 3 : integer
    online 4 : boolean
}

.ErrorFrame {
    error 0 : string
}

.CommandOutcomeFrame {
    rid 0 : string
    ok  1 : boolean
}

.GbankLogFrame {
    ok      0 : boolean
    entries 1 : *GbankLogEntry
}
.GbankLogEntry {
    op 0 : string
    pid 1 : integer
    amount 2 : integer
    itemId 3 : string
    itemName 4 : string
    timestamp 5 : integer
}
